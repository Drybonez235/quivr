---
const SITE_DEFAULT_TITLE = 'CRM for Financial Advisors | Quivr CRM – Built for Advisory Firms';
const SITE_DEFAULT_DESC = 'Quivr CRM: built by financial planners for planners to centralize client data, automate workflows, streamline compliance, and deliver a higher-quality, scalable client experience."';
const SITE_DEFAULT_IMG = 'http://static1.squarespace.com/static/67251c160dab253737d5daec/t/675319cdfcd22c0a12e9bdac/1733499342060/Quivr+website+photo+%28no+background%29.png?format=1500w'; // Placed in public/ folder

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: 'website';
}


const {
  title = SITE_DEFAULT_TITLE,
  description = SITE_DEFAULT_DESC,
  image = SITE_DEFAULT_IMG,
  type = 'website',
} = Astro.props;

const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
const formattedTitle = `${title}`;

---

<link rel="canonical" href={canonicalURL} />

<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<link rel="icon" type="image/x-icon" href="https://images.squarespace-cdn.com/content/v1/67251c160dab253737d5daec/e6fcf898-983a-48e3-803a-f02494e42312/favicon.ico?format=100w">
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />