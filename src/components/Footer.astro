---
import '../styles/global.css'
---
<footer class="bg-paper text-text border-t border-line py-12 px-6 md:px-12 relative overflow-hidden">
  <div class="max-w-6xl mx-auto flex flex-col justify-between min-h-[350px]">
    
    <!-- Main Content Grid -->
    <div class="w-full grid grid-cols-1 md:grid-cols-4 gap-8 text-left z-10 relative">
      <!-- Resources Column -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold tracking-wider uppercase text-text mb-4">Resources</h4>
        <ul class="space-y-3 text-sm text-text-dim">
          <li><a href="https://www.quivrcrm.io/articles" class="underline hover:text-red transition-colors">Articles</a></li>
          <li><a href="https://www.quivrcrm.io/videos" class="underline hover:text-red transition-colors">Videos</a></li>
          <li><a href="https://www.quivrcrm.io/integrations" class="underline hover:text-red transition-colors">Integrations</a></li>
          <li><a href="https://www.quivrcrm.io/contact" class="underline hover:text-red transition-colors">Contact Us</a></li>
          <li><a href="https://www.quivrcrm.io/team" class="underline hover:text-red transition-colors">Our Team</a></li>
          <li><a href="https://www.quivrcrm.io/news" class="underline hover:text-red transition-colors">News</a></li>
          <li><a href="https://www.quivrcrm.io/faqs" class="underline hover:text-red transition-colors">FAQs</a></li>
        </ul>
      </div>

      <!-- Product Column -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold tracking-wider uppercase text-text mb-4">Product</h4>
        <ul class="space-y-3 text-sm text-text-dim">
          <li><a href="https://www.quivrcrm.io/features" class="underline hover:text-red transition-colors">Features</a></li>
        </ul>
      </div>

      <!-- Pricing Column -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold tracking-wider uppercase text-text mb-4">Pricing</h4>
        <ul class="space-y-3 text-sm text-text-dim">
          <li><a href="https://www.quivrcrm.io/pricing" class="underline hover:text-red transition-colors">Pricing</a></li>
        </ul>
      </div>

      <!-- Legal Column -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold tracking-wider uppercase text-text mb-4">Legal</h4>
        <ul class="space-y-3 text-sm text-text-dim">
          <li><a href="https://www.quivrcrm.io/fulfillment-policy" class="underline hover:text-red transition-colors">Fulfillment Policy</a></li>
          <li><a href="https://www.dropbox.com/scl/fo/2mxde2w1jeri35ff19mh7/h?e=1&preview=Privacy+Policy.pdf&rlkey=fl41dhck4b5fh8lkislf5umiy&st=zrqu5y81&dl=0" target="_blank" rel="noopener noreferrer" class="underline hover:text-red transition-colors">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Centered Background/Overlay Logo -->
    <div class="hidden md:flex absolute inset-0 items-center justify-center pointer-events-none pt-8">
      <img src="Full+Logo+Transparent+Background+-+black.png" alt="Quivr CRM Logo" class="h-48 md:h-56 lg:h-64 w-auto object-contain">
    </div>

    <!-- Mobile-Only Logo (stacked properly for small screens) -->
    <div class="md:hidden flex justify-center my-8">
      <img src="Full+Logo+Transparent+Background+-+black.png" alt="Quivr CRM Logo" class="h-24 w-auto object-contain">
    </div>

    <!-- Bottom Section: Socials & Location -->
    <div class="w-full flex flex-col items-end gap-2 mt-8 z-10 text-xs text-text-dim">
      <div class="flex items-center gap-2">
        <a href="https://www.linkedin.com/company/quivr-crm/" target="_blank" aria-label="LinkedIn" class="w-8 h-8 rounded-full bg-red text-white flex items-center justify-center transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        </a>
        <a href="https://www.facebook.com/share/17GfJruWVR/?mibextid=wwXIfr" target="_blank" aria-label="Facebook" class="w-8 h-8 rounded-full bg-red text-white flex items-center justify-center transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
        </a>
        <a href="https://www.instagram.com/quivrcrm?igsh=MWVhZXRoNzc5bXBjbQ%3D%3D&utm_source=qr" target="_blank" aria-label="Instagram" class="w-8 h-8 rounded-full bg-red text-white flex items-center justify-center transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
