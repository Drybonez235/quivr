---

import '../styles/global.css'

---

<section class="pt-0 pb-[68px]">
      <div class="max-w-5xl mx-auto px-5">
        <div class="text-center" data-anim>
          <div class="text-xs font-bold tracking-widest uppercase text-red mb-3.5">Who's behind Quivr</div>
          <h2 class="text-2xl sm:text-3xl md:text-[38px] font-extrabold tracking-tight mb-3.5">Built by People Who <em class="not-italic text-red">Sit in Your Chair</em></h2>
          <p class="max-w-[58ch] mx-auto mb-10 text-text-dim text-[16.5px]">&nbsp;</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[760px] mx-auto">
          <div class="bg-white border border-line rounded-custom p-6 flex gap-4" data-anim="left">
            <div class="w-[60px] h-[60px] rounded-full bg-pine text-red-soft flex items-center justify-center font-black text-xl shrink-0">SD</div>
            <div>
              <h3 class="text-[16.5px] font-extrabold">Steve Drost</h3>
              <div class="text-[12.5px] font-extrabold text-red mb-1.5">Co-Founder · CFA, CFP®</div>
              <p class="text-[13.5px] text-text-dim">Nationally recognized financial planner. Built Quivr because no CRM matched how real planning firms work.</p>
            </div>
          </div>

          <div class="bg-white border border-line rounded-custom p-6 flex gap-4" data-anim="right">
            <div class="w-[60px] h-[60px] rounded-full bg-pine text-red-soft flex items-center justify-center font-black text-xl shrink-0">RD</div>
            <div>
              <h3 class="text-[16.5px] font-extrabold">Ryan Drost</h3>
              <div class="text-[12.5px] font-extrabold text-red mb-1.5">Co-Founder · CTO</div>
              <p class="text-[13.5px] text-text-dim">~20 years building software. Turns planner workflows into an engine your whole team can run on.</p>
            </div>
          </div>
        </div>
      </div>
    </section>