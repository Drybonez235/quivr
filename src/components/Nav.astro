---
import '../styles/global.css'
---

<!-- NAVIGATION BAR -->
<nav class="bg-ink py-2 px-2 md:px-6">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    
    <!-- Left: Brand Logo & Name -->
    <a href="#" class="flex items-center gap-2">
      <img src="Quivr+Logo+White.png" alt="Quivr Logo" class="h-28 w-auto object-contain">
      <span class="font-black text-xl text-white tracking-wide">QUIVR</span>
    </a>

    <!-- Right: Tagline & CTA Button -->
    <div class="flex items-center gap-6">
      <span class="hidden md:inline-block text-xs font-semibold text-[#D9BDB8]">
        Built by CFPs. Perfected by operations pros.
      </span>
      <a href="#leadForm" class="bg-black text-white font-extrabold text-xs tracking-wider uppercase px-4 py-2.5 rounded hover:bg-black/80 transition-colors">
        Get Started
      </a>
    </div>

  </div>
</nav>