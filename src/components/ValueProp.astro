---
import '../styles/global.css';  
---
<div class="stats bg-white border-b border-line py-9.5">
      <div class="max-w-5xl mx-auto px-5 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="stat" data-anim style="--d:0s">
          <div class="w-7.5 h-7.5 text-red mx-auto mb-1 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/></svg>
          </div>
          <b class="block text-4xl sm:text-4xl font-black text-red tracking-tight" data-count="150" data-prefix="~">~150</b>
          <span class="text-xs font-bold tracking-wider uppercase text-text-dim">Hours back per year (2–3 hrs/wk)</span>
        </div>
        <div class="stat" data-anim style="--d:.08s">
          <div class="w-7.5 h-7.5 text-red mx-auto mb-1 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
          </div>
          <b class="block text-4xl sm:text-4xl font-black text-red tracking-tight" data-count="2" data-suffix="×">2X</b>
          <span class="text-xs font-bold tracking-wider uppercase text-text-dim">Faster client deliverables</span>
        </div>
        <div class="stat" data-anim style="--d:.16s">
          <div class="w-7.5 h-7.5 text-red mx-auto mb-1 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.6 6.3.8-4.6 4.2 1.2 6.1L12 16.8 6.4 19.7l1.2-6.1L3 9.4l6.3-.8L12 3z"/></svg>
          </div>
          <b class="block text-4xl sm:text-4xl font-black text-red tracking-tight" data-count="9.47" data-dec="2">9.47</b>
          <span class="text-xs font-bold tracking-wider uppercase text-text-dim">Top user rating. T3 2026</span>
        </div>
        <div class="stat" data-anim style="--d:.24s">
          <div class="w-7.5 h-7.5 text-red mx-auto mb-1 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>
          </div>
          <b class="block text-4xl sm:text-4xl font-black text-red tracking-tight" 
   data-count="7" 
   data-prefix="&lt;" 
   data-suffix=" days">&lt;7 Days</b>
          <span class="text-xs font-bold tracking-wider uppercase text-text-dim">Full data migration</span>
        </div>
      </div>
    </div>