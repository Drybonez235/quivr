---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAstroComponent from '../components/Hero.astro';
import FooterAstroComponent from '../components/Footer.astro';
import HeroFullWidthImageAstroComponent from '../components/VividReal-Theme/VividReal-Hero.astro';
import VividRealValuePropComponent from '../components/VividReal-Theme/VividReal-ValueProp.astro'; 
import VividRealCompanyMissionAstroComponent from '../components/VividReal-Theme/VividReal-CompanyMission.astro';
import VividRealAboutUsComponent from '../components/VividReal-Theme/VividReal-AboutUs.astro';
import SocialsAstroComponent from '../components/Socials.astro';
import VividRealSocialProof from '../components/VividReal-Theme/VividReal-SocialProof.astro';
import VividRealFinalCTA from '../components/VividReal-Theme/VividReal-FinalCTA.astro';
import '../styles/global.css';  
import Form from '../components/form.astro';
import VividRealValueProp from '../components/VividReal-Theme/VividReal-ValueProp.astro';
---

<BaseLayout 
  title="Home Page" 
  description="Welcome to my lightning fast website built with Astro."
  image="/images/home-og.jpg"
>
  <main>
   <HeroFullWidthImageAstroComponent></HeroFullWidthImageAstroComponent>
   <VividRealValuePropComponent></VividRealValuePropComponent> 
   <VividRealCompanyMissionAstroComponent></VividRealCompanyMissionAstroComponent>
   <VividRealSocialProof></VividRealSocialProof>
   <VividRealAboutUsComponent></VividRealAboutUsComponent>
   <VividRealFinalCTA></VividRealFinalCTA>
   
  </main>
</BaseLayout>

